CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192
CONFIG_ESPB_SHADOW_STACK_INITIAL_SIZE=1024
CONFIG_ESPB_SHADOW_STACK_INCREMENT=1024
CONFIG_LIBFFI_USE_IRAM_POOL=y
CONFIG_LIBFFI_IRAM_POOL_SIZE=1024

# Keep the full semantic QEMU corpus practical: opcode-level DEBUG tracing
# and per-instruction debug checks are diagnostic modes, not normal CI modes.
# The module assertions and interpreter/JIT paired checks remain enabled.
CONFIG_ESPB_DEBUG_CHECKS=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
