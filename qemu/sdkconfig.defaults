CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192
CONFIG_ESPB_SHADOW_STACK_INCREMENT=1024
CONFIG_LIBFFI_USE_IRAM_POOL=y
CONFIG_LIBFFI_IRAM_POOL_SIZE=1024

# Temporary interpreter diagnostics for ESPB bytecode investigation.
CONFIG_ESPB_DEBUG_CHECKS=y
# Keep opcode-level ESP_LOGD tracing opt-in; verbose tracing makes QEMU
# benchmarks orders of magnitude slower and can hide real test completion.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
